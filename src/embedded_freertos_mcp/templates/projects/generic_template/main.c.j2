#include "FreeRTOS.h"
#include "task.h"
#include "system.h"

/* 项目名称: {{ project_name }} */
/* 芯片: {{ chip_family }} */

int main(void)
{
    /* 系统初始化 */
    System_Init();
    
    /* 创建FreeRTOS任务 */
    {% for task in tasks %}
    xTaskCreate({{ task.function }}, "{{ task.name }}", {{ task.stack_size }}, NULL, {{ task.priority }}, NULL);
    {% endfor %}
    
    /* 启动调度器 */
    vTaskStartScheduler();
    
    /* 程序不应执行到这里 */
    while(1);
}

{% for task in tasks %}
void {{ task.function }}(void *pvParameters)
{
    for(;;)
    {
        /* {{ task.name }} 任务代码 */
        vTaskDelay({{ task.delay }} / portTICK_PERIOD_MS);
    }
}
{% endfor %}